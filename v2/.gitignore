# Godot 4+ specific ignores
.godot/
/android/
tmp/*
!tmp/convert.bat
*exe

# root ignores dist/; keep the per-OS export folders + their libs
!/dist/
/dist/*
!/dist/windows/
!/dist/linux/
!/dist/mac/
!/dist/web/
/dist/*/*
!/dist/*/.stub
!/dist/windows/*.dll
!/dist/linux/*.so

# same for the demo builds in dist/demo/
!/dist/demo/
!/dist/demo/windows/
!/dist/demo/linux/
!/dist/demo/mac/
/dist/demo/*/*
!/dist/demo/*/.stub
!/dist/demo/windows/*.dll
!/dist/demo/linux/*.so
