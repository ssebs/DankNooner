{
  "todoSidebar.onDoneAction": "move",
  "editor.detectIndentation": false,
  "editor.insertSpaces": false,
  "editor.tabSize": 4,
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/*.uid": true,
    "**/*.import": true,
    "**/*.godot/*": true,
    "**/*.stub": true
  },
  "[gdscript]": {
    "editor.defaultFormatter": "geequlim.godot-tools"
  },
  "editor.formatOnSave": true,
  "godotTools.editorPath.godot4": "/Applications/Godot.app",
  "todoSidebar.activeFile": "./planning_docs/TODO.md",
  "cSpell.enabled": false,
  "markdown.extension.toc.levels": "2..6"
}