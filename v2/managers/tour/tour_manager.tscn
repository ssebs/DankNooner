[gd_scene format=3]

[ext_resource type="Script" path="res://managers/tour/tour_manager.gd" id="1_script"]
[ext_resource type="Theme" path="res://resources/themes/DankNoonerNeon.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://player/hud_elements/input_prompt.tscn" id="3_prompt"]

[node name="TourManager" type="Node"]
script = ExtResource("1_script")

[node name="CanvasLayer" type="CanvasLayer" parent="."]
