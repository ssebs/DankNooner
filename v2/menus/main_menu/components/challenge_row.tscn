[gd_scene format=3]

[ext_resource type="Script" path="res://menus/main_menu/components/challenge_row.gd" id="1_row"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_track"]
bg_color = Color(1, 1, 1, 0.15)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_fill"]
