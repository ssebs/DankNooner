[gd_scene format=3]

[ext_resource type="Script" path="res://menus/saves_menu/components/save_card.gd" id="1_card"]
[ext_resource type="PackedScene" path="res://menus/saves_menu/components/save_preview.tscn" id="2_preview"]

[node name="SaveCard" type="PanelContainer"]
custom_minimum_size = Vector2(300, 440)
script = ExtResource("1_card")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="NewBtn" type="Button" parent="Margin"]
unique_name_in_owner = true
layout_mode = 2
mouse_default_cursor_shape = 2
theme_override_font_sizes/font_size = 128
text = "+"
flat = true

[node name="Filled" type="VBoxContainer" parent="Margin"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 12

[node name="ActiveLabel" type="Label" parent="Margin/Filled"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"OwnLabel"
text = "SAVE_SLOT_ACTIVE"
horizontal_alignment = 1

[node name="Preview" parent="Margin/Filled" instance=ExtResource("2_preview")]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4

[node name="NameEdit" type="LineEdit" parent="Margin/Filled"]
unique_name_in_owner = true
layout_mode = 2
max_length = 24

[node name="StatsLabel" type="Label" parent="Margin/Filled"]
unique_name_in_owner = true
layout_mode = 2
auto_translate_mode = 2

[node name="VersionLabel" type="Label" parent="Margin/Filled"]
unique_name_in_owner = true
layout_mode = 2
auto_translate_mode = 2

[node name="Buttons" type="HBoxContainer" parent="Margin/Filled"]
layout_mode = 2
size_flags_vertical = 10
theme_override_constants/separation = 36

[node name="DeleteBtn" type="Button" parent="Margin/Filled/Buttons"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
mouse_default_cursor_shape = 2
text = "DELETE_LABEL"
